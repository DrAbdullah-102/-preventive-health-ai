        <div
          key={toast.id}
          onClick={() => onRemove(toast.id)}
          style={{
            padding: '12px 20px',
            borderRadius: 12,
            cursor: 'pointer',
            fontSize: 13,
            fontWeight: 500,
            maxWidth: 320,
            textAlign: 'center',
            animation: 'fadeUp 0.3s ease',
            background:
              toast.type === 'success' ? '#052e16' :
