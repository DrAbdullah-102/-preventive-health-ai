interface Props {
  members: FamilyMember[]
  noFamilyHistory: boolean
  onChange: (members: FamilyMember[], noHistory: boolean) => void
}

function generateId() {
  return Math.random().toString(36).slice(2, 9)
}

function emptyMember(): FamilyMember {
  return {
    id: generateId(),
    relative: '',
    disease: '',
    age_at_diagnosis: '',
    notes: '',
    is_alive: null,
    is_smoker: null,
    degree: 'first',
  }
}

export default function FamilyHistoryBuilder({ members, noFamilyHistory, onChange }: Props) {
  const [expandedId, setExpandedId] = useState<string | null>(null)

  const addMember = () => {
    const m = emptyMember()
    onChange([...members, m], false)
    setExpandedId(m.id)
  }

  const removeMember = (id: string) => {
    onChange(members.filter(m => m.id !== id), noFamilyHistory)
  }

  const updateMember = (id: string, patch: Partial<FamilyMember>) => {
    onChange(
      members.map(m => {
        if (m.id !== id) return m
        const updated = { ...m, ...patch }
        if (patch.relative) {
          updated.degree = getFamilyDegree(patch.relative)
        }
        return updated
      }),
      false
    )
  }

  const setNoHistory = () => {
    onChange([], true)
