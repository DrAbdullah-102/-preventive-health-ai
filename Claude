            color:
              toast.type === 'success' ? '#34d399' :
              toast.type === 'error' ? '#f87171' : '#ccc',
            border: `1px solid ${
              toast.type === 'success' ? '#34d39944' :
              toast.type === 'error' ? '#f8717144' : '#2a2a3a'
            }`,
          }}
        >
          {toast.type === 'success' ? '✓ ' : toast.type === 'error' ? '✕ ' : 'ℹ '}
          {toast.message}
        </div>
      ))}
    </div>
  )
}



