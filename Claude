import { NextRequest, NextResponse } from 'next/server'
import { createClient } from '@/lib/supabase/server'
import { analyzeHealthRisk } from '@/lib/claude'
import {
  calculateBMI, getBMICategory,
  calculateRiskScore, getRiskMeta,
  buildScreenings, buildLifestyleTips,
  buildPositives, buildFamilySummary,
} from '@/lib/risk-engine'
import type { HealthFormData } from '@/types'

export async function POST(req: NextRequest) {
  try {
    const supabase = await createClient()
    const { data: { user }, error: authError } = await supabase.auth.getUser()
    if (authError || !user) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    const form: HealthFormData = await req.json()

    if (!form.age || !form.gender || !form.height || !form.weight) {
      return NextResponse.json({ error: 'Missing required fields' }, { status: 400 })
    }

    // Compute everything
    const bmi = calculateBMI(form.height, form.weight)!
    const bmiMeta = getBMICategory(bmi)
    const { total: riskScore, breakdown } = calculateRiskScore(form, bmi)
    const riskMeta = getRiskMeta(riskScore)
    const screenings = buildScreenings(form, bmi, riskScore)
    const lifestyleTips = buildLifestyleTips(form, bmi)
    const positives = buildPositives(form, bmi)
    const familySummary = buildFamilySummary(form)

    // Claude AI insight (server-side — API key never reaches browser)
    let aiInsight = ''
    try {
      aiInsight = await analyzeHealthRisk({
        age: parseInt(form.age),
        gender: form.gender as string,
        bmi,
        bmiLabel: bmiMeta.label,
        smoking: form.habits.smoking,
        exercise: form.habits.exercise,
        sleep: form.habits.sleep,
        diet: form.habits.diet,
        stress: form.habits.stress,
        familyHistory: familySummary,
        riskScore,
        riskLevel: riskMeta.level,
        topRisks: breakdown
          .sort((a, b) => b.score - a.score)
          .slice(0, 3)
          .map(b => b.category)
          .join('، '),
      })
    } catch (claudeErr) {
      console.error('Claude error (non-fatal):', claudeErr)
      aiInsight = 'تعذّر الحصول على تحليل AI الآن. بياناتك حُفظت بنجاح.'
    }

    // Save to Supabase
    const { data: savedReport, error: dbError } = await supabase
      .from('health_reports')
      .insert({
        user_id: user.id,
        age: parseInt(form.age),
        gender: form.gender,
        height: parseFloat(form.height),
        weight: parseFloat(form.weight),
        bmi,
        risk_score: riskScore,
        risk_level: riskMeta.level,
        family_members: form.familyMembers,
        no_family_history: form.noFamilyHistory,
        habits: form.habits,
        screenings,
        lifestyle_tips: lifestyleTips,
        positives,
        risk_breakdown: breakdown,
        ai_insight: aiInsight,
      })
      .select('id')
      .single()

    if (dbError) console.error('DB save error (non-fatal):', dbError)

    return NextResponse.json({
      report: {
        id: savedReport?.id,
        bmi,
        bmiMeta,
        riskScore,
        riskLevel: riskMeta.level,
        riskColor: riskMeta.color,
        riskBg: riskMeta.bg,
        riskDescription: riskMeta.description,
        screenings,
        lifestyleTips,
        positives,
        riskBreakdown: breakdown,
        aiInsight,
        savedToDb: !dbError,
      }
    })

  } catch (err) {
    console.error('analyze-health error:', err)
    return NextResponse.json({ error: 'Internal server error' }, { status: 500 })
  }
}



