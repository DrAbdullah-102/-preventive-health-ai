'use client'
import type { TrendPoint } from '@/types'

interface Props {
  data: TrendPoint[]
  color?: string
  label?: string
  unit?: string
  height?: number
  showDots?: boolean
}

export default function TrendChart({
  data, color = '#34d399', label, unit = '',
  height = 80, showDots = true
}: Props) {
  if (!data || data.length === 0) return (
    <div style={{ height, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
      <span style={{ color: '#444', fontSize: 12 }}>لا توجد بيانات كافية</span>
    </div>
  )

  if (data.length === 1) return (
    <div style={{ height, display: 'flex', alignItems: 'center', gap: 12 }}>
      <span style={{ fontSize: 28, fontWeight: 800, color }}>{data[0].value}</span>
      <span style={{ color: '#555', fontSize: 12 }}>{unit} — قراءة واحدة فقط</span>
    </div>
  )

  const values = data.map(d => d.value)
  const min = Math.min(...values)
  const max = Math.max(...values)
  const range = max - min || 1
  const w = 100
  const h = height

  const pts = data.map((d, i) => {
    const x = (i / (data.length - 1)) * w
    const y = h - ((d.value - min) / range) * (h * 0.8) - h * 0.1
    return { x, y, ...d }
  })

  const polyline = pts.map(p => `${p.x},${p.y}`).join(' ')
  const polygon = `0,${h} ${polyline} ${w},${h}`

  // Trend arrow
  const first = values[0], last = values[values.length - 1]
  const trend = last > first ? '↑' : last < first ? '↓' : '→'
  const trendColor = last > first ? '#f87171' : last < first ? '#34d399' : '#fbbf24'
  const trendPct = first !== 0 ? (((last - first) / first) * 100).toFixed(1) : '0'

  return (
    <div>
      {label && (
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
          <span style={{ color: '#888', fontSize: 12, fontWeight: 600 }}>{label}</span>
          <span style={{ color: trendColor, fontSize: 12, fontWeight: 700 }}>
            {trend} {Math.abs(parseFloat(trendPct))}%
          </span>
        </div>
      )}

      <svg
        viewBox={`0 0 100 ${h}`}
        style={{ width: '100%', height }}
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id={`grad-${label}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor={color} stopOpacity="0.25" />
            <stop offset="100%" stopColor={color} stopOpacity="0.02" />
          </linearGradient>
        </defs>

        {/* Grid lines */}
        {[0.25, 0.5, 0.75].map((pct, i) => (
          <line key={i}
            x1="0" y1={h * pct} x2={w} y2={h * pct}
            stroke="#1a1a2a" strokeWidth="0.5"
          />
        ))}

        {/* Fill area */}
        <polygon points={polygon} fill={`url(#grad-${label})`} />

        {/* Line */}
        <polyline
          points={polyline}
          fill="none" stroke={color}
          strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"
        />

        {/* Dots */}
        {showDots && pts.map((p, i) => (
          <circle key={i} cx={p.x} cy={p.y} r="2" fill={color} />
        ))}
      </svg>

      {/* X-axis dates */}
      {data.length <= 8 && (
        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: 4 }}>
          {data.map((d, i) => (
            <span key={i} style={{ fontSize: 9, color: '#444' }}>
              {new Date(d.date).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' })}
            </span>
          ))}
        </div>
      )}

      {/* Min/Max labels */}
      <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: 4 }}>
        <span style={{ fontSize: 10, color: '#555' }}>
          أقل: <strong style={{ color }}>{min}{unit}</strong>
        </span>
        <span style={{ fontSize: 10, color: '#555' }}>
          أعلى: <strong style={{ color }}>{max}{unit}</strong>
        </span>
      </div>
    </div>
  )
}



