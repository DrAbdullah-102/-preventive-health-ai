  const [dragOver, setDragOver] = useState(false)
  const [selectedReport, setSelectedReport] = useState<LabReport | null>(null)
  const fileRef = useRef<HTMLInputElement>(null)
  const supabase = createClient()

  const fetchReports = async () => {
    if (!user) return
    const { data } = await supabase
      .from('lab_reports')
      .select('*')
      .eq('user_id', user.id)
      .order('created_at', { ascending: false })
    setLabReports(data ?? [])
    setLoadingReports(false)
  }

  useEffect(() => { fetchReports() }, [user])

  const handleFile = async (file: File) => {
    const allowed = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
    if (!allowed.includes(file.type)) {
      addToast('الملفات المسموح بها: PDF, JPG, PNG', 'error')
      return
    }
    if (file.size > 10 * 1024 * 1024) {
      addToast('حجم الملف لا يتجاوز 10 ميجابايت', 'error')
      return
    }

    setUploading(true)
    addToast('جاري رفع وتحليل الملف...', 'info')

    const formData = new FormData()
    formData.append('file', file)

    try {
      const res = await fetch('/api/analyze-lab', {
        method: 'POST',
        body: formData,
      })

      if (!res.ok) throw new Error('Upload failed')

      const data = await res.json()
      if (data.success) {
        addToast('تم تحليل التقرير بنجاح ✓', 'success')
        fetchReports()
      } else {
        addToast('فشل في تحليل الملف', 'error')
      }
    } catch {
      addToast('حدث خطأ أثناء الرفع', 'error')
    } finally {
      setUploading(false)
    }
  }

  const handleDrop = (e: React.DragEvent) => {
    e.preventDefault()
    setDragOver(false)
    const file = e.dataTransfer.files[0]
    if (file) handleFile(file)
  }

  return (
    <div style={styles.root} className="fade-up">
      <ToastContainer toasts={toasts} onRemove={removeToast} />

      <div style={styles.pageHeader}>
        <div>
          <h1 style={styles.pageTitle}>التحاليل المخبرية</h1>
          <p style={styles.pageSubtitle}>ارفع تحليلك وسيقرأه الذكاء الاصطناعي ويشرحه لك</p>
        </div>
      </div>

      {/* Upload Zone */}
      <div
        style={{
          ...styles.uploadZone,
          borderColor: dragOver ? '#34d399' : uploading ? '#818cf8' : '#2a2a3a',
          background: dragOver ? '#052e1610' : uploading ? '#1e1e3a10' : '#0d0d14',
        }}
        onDragOver={e => { e.preventDefault(); setDragOver(true) }}
        onDragLeave={() => setDragOver(false)}
        onDrop={handleDrop}
        onClick={() => !uploading && fileRef.current?.click()}
        className="fade-up"
      >
        <input
          ref={fileRef}
          type="file"
          accept=".pdf,.jpg,.jpeg,.png,.webp"
          style={{ display: 'none' }}
          onChange={e => { const f = e.target.files?.[0]; if (f) handleFile(f) }}
        />

        {uploading ? (
          <>
            <div style={{ ...styles.spinner, width: 32, height: 32, borderWidth: 3, marginBottom: 16 }} />
            <div style={{ color: '#818cf8', fontWeight: 600 }}>جاري التحليل بالذكاء الاصطناعي...</div>
            <div style={{ color: '#555', fontSize: 12, marginTop: 6 }}>قد يستغرق من 15-30 ثانية</div>
          </>
        ) : (
          <>
            <div style={{ fontSize: 40, marginBottom: 12 }}>🧪</div>
            <div style={{ color: '#ccc', fontWeight: 600, marginBottom: 6 }}>
              {dragOver ? 'أفلت الملف هنا' : 'اسحب ملفك هنا أو انقر للاختيار'}
            </div>
            <div style={{ color: '#555', fontSize: 12 }}>PDF, JPG, PNG — حد أقصى 10 ميجابايت</div>
            <div style={{ marginTop: 16, padding: '8px 20px', background: '#1a1a2a', borderRadius: 100, fontSize: 12, color: '#666' }}>
              اختر ملف
            </div>
          </>
        )}
      </div>

      {/* How it works */}
      <div style={styles.howItWorks} className="fade-up fade-up-d1">
        {[
          { icon: '📤', label: 'ارفع التحليل' },
          { icon: '🤖', label: 'Claude يقرأه' },
          { icon: '📋', label: 'تحليل مبسط' },
          { icon: '⚠️', label: 'تنبيه إذا لزم' },
        ].map((s, i) => (
          <div key={i} style={styles.step}>
            <span style={{ fontSize: 22 }}>{s.icon}</span>
            <span style={{ fontSize: 11, color: '#555', marginTop: 4 }}>{s.label}</span>
          </div>
        ))}
      </div>

      {/* Reports List */}
      {loadingReports ? (
        <div style={{ textAlign: 'center', padding: 40 }}>
          <div style={styles.spinner} />
        </div>
      ) : labReports.length === 0 ? (
        <div style={styles.emptyState}>
          <div style={{ fontSize: 40, marginBottom: 12 }}>📂</div>
          <div style={{ color: '#555' }}>لا توجد تحاليل مرفوعة بعد</div>
        </div>
      ) : (
        <div className="fade-up fade-up-d2">
          <div style={styles.sectionTitle}>تحاليلك المرفوعة ({labReports.length})</div>
          {labReports.map(lr => (
            <div
