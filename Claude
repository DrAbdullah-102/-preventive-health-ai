import type {
  HealthFormData, FamilyMember, RiskBreakdown,
  Screening, RelativeType, FamilyDegree
} from '@/types'

// ── BMI ─────────────────────────────────────────────────────
export function calculateBMI(height: string, weight: string): number | null {
  if (!height || !weight) return null
  const h = parseFloat(height), w = parseFloat(weight)
  if (!h || !w) return null
  return parseFloat((w / Math.pow(h / 100, 2)).toFixed(1))
}

export function getBMICategory(bmi: number): { label: string; color: string } {
  if (bmi < 18.5) return { label: 'نقص وزن', color: '#60a5fa' }
  if (bmi < 25)   return { label: 'طبيعي',    color: '#34d399' }
  if (bmi < 30)   return { label: 'زيادة وزن', color: '#fbbf24' }
  if (bmi < 35)   return { label: 'سمنة درجة أولى', color: '#f97316' }
  return             { label: 'سمنة مفرطة',   color: '#f87171' }
}

// ── Family degree ────────────────────────────────────────────
export function getFamilyDegree(relative: RelativeType | string): FamilyDegree {
  const firstDegree: RelativeType[] = ['father', 'mother', 'brother', 'sister', 'son', 'daughter']
  return firstDegree.includes(relative as RelativeType) ? 'first' : 'second'
}

// ── Risk Score ───────────────────────────────────────────────
export function calculateRiskScore(form: HealthFormData, bmi: number): {
  total: number
  breakdown: RiskBreakdown[]
} {
  const breakdown: RiskBreakdown[] = []

  // 1. BMI
  let bmiScore = 0
  if (bmi >= 35) bmiScore = 28
  else if (bmi >= 30) bmiScore = 22
  else if (bmi >= 27) bmiScore = 15
  else if (bmi >= 25) bmiScore = 10
  else if (bmi < 18.5) bmiScore = 7
  breakdown.push({
    category: 'مؤشر الكتلة',
    score: bmiScore, maxScore: 28,
    details: `BMI ${bmi} — ${getBMICategory(bmi).label}`
  })

  // 2. Age
  const age = parseInt(form.age)
  let ageScore = 0
  if (age > 65) ageScore = 25
  else if (age > 55) ageScore = 20
  else if (age > 45) ageScore = 14
  else if (age > 35) ageScore = 8
  else if (age > 25) ageScore = 3
  breakdown.push({
    category: 'العمر',
    score: ageScore, maxScore: 25,
    details: `${age} سنة`
  })

  // 3. Smoking
  let smokingScore = 0
  if (form.habits.smoking === 'heavy') smokingScore = 28
  else if (form.habits.smoking === 'moderate') smokingScore = 20
  else if (form.habits.smoking === 'light') smokingScore = 12
  else if (form.habits.smoking === 'ex') smokingScore = 6
  breakdown.push({
    category: 'التدخين',
    score: smokingScore, maxScore: 28,
    details: form.habits.smoking === 'none' ? 'لا يدخن' :
             form.habits.smoking === 'ex' ? 'مدخن سابق' :
             form.habits.smoking === 'light' ? 'خفيف' :
             form.habits.smoking === 'moderate' ? 'متوسط' : 'ثقيل'
  })

  // 4. Exercise
  let exScore = 0
  if (form.habits.exercise === 'none') exScore = 14
  else if (form.habits.exercise === 'rarely') exScore = 9
  else if (form.habits.exercise === 'moderate') exScore = 4
  breakdown.push({
    category: 'النشاط البدني',
    score: exScore, maxScore: 14,
    details: form.habits.exercise === 'none' ? 'خامل تماماً' :
             form.habits.exercise === 'rarely' ? 'نادراً' :
             form.habits.exercise === 'moderate' ? '2-3 مرات/أسبوع' :
             form.habits.exercise === 'frequent' ? '4-5 مرات' : 'يومياً'
  })

  // 5. Sleep
  let sleepScore = 0
  if (form.habits.sleep === 'very_low') sleepScore = 12
  else if (form.habits.sleep === 'low') sleepScore = 7
  else if (form.habits.sleep === 'excess') sleepScore = 4
  breakdown.push({
    category: 'النوم',
    score: sleepScore, maxScore: 12,
    details: form.habits.sleep === 'very_low' ? 'أقل من 5 ساعات' :
             form.habits.sleep === 'low' ? '5-6 ساعات' :
             form.habits.sleep === 'good' ? '7-8 ساعات ✓' : 'أكثر من 9 ساعات'
  })

  // 6. Diet
  let dietScore = 0
  if (form.habits.diet === 'poor') dietScore = 14
  else if (form.habits.diet === 'average') dietScore = 7
  breakdown.push({
    category: 'التغذية',
    score: dietScore, maxScore: 14,
    details: form.habits.diet === 'poor' ? 'وجبات سريعة يومياً' :
             form.habits.diet === 'average' ? 'متوسط' : 'صحي ومتوازن ✓'
  })

  // 7. Stress
  let stressScore = 0
  if (form.habits.stress === 'very_high') stressScore = 13
  else if (form.habits.stress === 'high') stressScore = 8
  else if (form.habits.stress === 'moderate') stressScore = 3
  breakdown.push({
    category: 'التوتر',
    score: stressScore, maxScore: 13,
    details: form.habits.stress === 'very_high' ? 'مرتفع جداً' :
             form.habits.stress === 'high' ? 'مرتفع' :
             form.habits.stress === 'moderate' ? 'متوسط' : 'منخفض ✓'
  })

  // 8. Family History
  const firstDeg = form.familyMembers.filter(m => m.degree === 'first' && m.disease && m.disease !== '')
  const secondDeg = form.familyMembers.filter(m => m.degree === 'second' && m.disease && m.disease !== '')
  const familyScore = Math.min(firstDeg.length * 7 + secondDeg.length * 3, 28)
  breakdown.push({
    category: 'التاريخ العائلي',
    score: familyScore, maxScore: 28,
    details: form.noFamilyHistory
      ? 'لا يوجد تاريخ عائلي'
      : `${firstDeg.length} درجة أولى، ${secondDeg.length} درجة ثانية`
  })

  const total = Math.min(breakdown.reduce((s, b) => s + b.score, 0), 100)
  return { total, breakdown }
}

