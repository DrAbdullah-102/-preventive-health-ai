export async function analyzeLabReportVision(
  base64: string,
  mediaType: string
): Promise<{ analysis: string; hasAbnormal: boolean; urgentFlag: boolean; summary: string }> {
  const isPdf = mediaType === 'application/pdf'

  const contentBlock = isPdf
    ? { type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: base64 } }
    : { type: 'image', source: { type: 'base64', media_type: mediaType, data: base64 } }

  const prompt = `أنت طبيب وقائي متخصص في قراءة التحاليل الطبية. حلّل هذا التحليل بطريقة وقائية مبسطة للمريض باللغة العربية.

قدم ردك بهذا التنسيق حرفياً (لا تغيّر العناوين):

SUMMARY: [جملة واحدة تلخص نتيجة التحليل]
HAS_ABNORMAL: [true أو false]
URGENT: [true أو false — true فقط إذا كانت قيم تستدعي مراجعة طبيب خلال أسبوع]

ANALYSIS:
[فقرتان: الأولى تشرح القيم غير الطبيعية إن وجدت مع ذكر القيم المرجعية، والثانية النصيحة الوقائية. إذا كانت كل القيم طبيعية، اذكر ذلك بوضوح وأضف نصيحة وقائية عامة. إذا تعذّر قراءة الملف، اذكر ذلك صراحةً.]`

  const raw = await callClaude(
    [{ role: 'user', content: [contentBlock, { type: 'text', text: prompt }] }],
    900
  )

  const summaryMatch = raw.match(/SUMMARY:\s*(.+)/i)
  const hasAbnormalMatch = raw.match(/HAS_ABNORMAL:\s*(true|false)/i)
  const urgentMatch = raw.match(/URGENT:\s*(true|false)/i)
  const analysisMatch = raw.match(/ANALYSIS:\s*([\s\S]+)/i)

  return {
    summary: summaryMatch?.[1]?.trim() ?? 'تم تحليل التقرير',
    hasAbnormal: hasAbnormalMatch?.[1]?.toLowerCase() === 'true',
    urgentFlag: urgentMatch?.[1]?.toLowerCase() === 'true',
    analysis: analysisMatch?.[1]?.trim() ?? raw,
  }
}



