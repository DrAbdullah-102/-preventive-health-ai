import { NextRequest, NextResponse } from 'next/server'
import { createClient } from '@/lib/supabase/server'
import { analyzeLabReportVision } from '@/lib/claude'

const MAX_SIZE = 10 * 1024 * 1024
const ALLOWED = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']

export async function POST(req: NextRequest) {
  try {
    const supabase = await createClient()
    const { data: { user }, error: authError } = await supabase.auth.getUser()
    if (authError || !user) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    const formData = await req.formData()
    const file = formData.get('file') as File | null

    if (!file) return NextResponse.json({ error: 'No file' }, { status: 400 })
    if (!ALLOWED.includes(file.type)) return NextResponse.json({ error: 'نوع الملف غير مدعوم. استخدم PDF أو JPG أو PNG' }, { status: 400 })
    if (file.size > MAX_SIZE) return NextResponse.json({ error: 'حجم الملف يتجاوز 10 ميجابايت' }, { status: 400 })

    // Upload to Supabase Storage
    const ext = file.name.split('.').pop() ?? 'bin'
    const storagePath = `${user.id}/${Date.now()}.${ext}`
    const buffer = new Uint8Array(await file.arrayBuffer())

    const { error: uploadError } = await supabase.storage
      .from('lab-files')
      .upload(storagePath, buffer, { contentType: file.type, upsert: false })

    if (uploadError) {
      console.error('Storage error:', uploadError)
      return NextResponse.json({ error: 'فشل رفع الملف' }, { status: 500 })
    }

    // Get signed URL (7 days)
    const { data: urlData } = await supabase.storage
      .from('lab-files')
      .createSignedUrl(storagePath, 60 * 60 * 24 * 7)

    // Create DB record
    const { data: labRecord, error: dbError } = await supabase
      .from('lab_reports')
      .insert({
        user_id: user.id,
        file_name: file.name,
        file_url: urlData?.signedUrl ?? '',
        file_type: file.type,
        file_size: file.size,
        status: 'processing',
      })
      .select('id')
      .single()

    if (dbError || !labRecord) {
      return NextResponse.json({ error: 'Database error' }, { status: 500 })
    }

    // Send to Claude Vision
    const base64 = Buffer.from(buffer).toString('base64')
    const { analysis, hasAbnormal, urgentFlag, summary } = await analyzeLabReportVision(base64, file.type)

    // Update DB record
    await supabase
      .from('lab_reports')
      .update({
        ai_analysis: analysis,
        has_abnormal_values: hasAbnormal,
        urgent_flag: urgentFlag,
        summary,
        status: 'done',
      })
      .eq('id', labRecord.id)

    return NextResponse.json({
      success: true,
      labReport: {
        id: labRecord.id,
        fileName: file.name,
        analysis,
        hasAbnormal,
        urgentFlag,
        summary,
        status: 'done',
      }
    })

  } catch (err) {
    console.error('analyze-lab error:', err)
    return NextResponse.json({ error: 'Internal server error' }, { status: 500 })
  }
}



