// ── Lifestyle Tips ───────────────────────────────────────────
export function buildLifestyleTips(form: HealthFormData, bmi: number): string[] {
  const tips: string[] = []

  if (form.habits.sleep === 'very_low')
    tips.push('النوم أقل من 5 ساعات يرفع خطر أمراض القلب والسكري بشكل ملموس — ضع هدفاً لـ 7 ساعات')
  else if (form.habits.sleep === 'low')
    tips.push('زد نومك لـ 7-8 ساعات — فقط ساعة إضافية تُحسّن المناعة وتخفّض الكورتيزول')

  if (form.habits.exercise === 'none')
    tips.push('ابدأ بـ 20 دقيقة مشي يومياً — هذا وحده يخفض خطر الوفاة المبكرة بنسبة 20-30%')
  else if (form.habits.exercise === 'rarely')
    tips.push('زد نشاطك لـ 150 دقيقة أسبوعياً وفق توصية WHO — يمكن تقسيمها على 5 أيام')

  if (form.habits.diet === 'poor')
    tips.push('ابدأ بتغيير واحد: احذف المشروبات السكرية — هذا التغيير وحده يخفض خطر السكري بـ 25%')

  if (form.habits.stress === 'very_high')
    tips.push('التوتر المزمن يُحدث التهاباً في الشرايين — 10 دقائق تنفس عميق يومياً تُخفّض الكورتيزول فعلياً')
  else if (form.habits.stress === 'high')
    tips.push('الضغط المستمر يؤثر على القلب والمناعة — مارس نشاطاً بدنياً أو تأمل بانتظام')

  if (form.habits.smoking === 'heavy' || form.habits.smoking === 'moderate')
    tips.push('الإقلاع عن التدخين هو أكبر قرار يمكنك اتخاذه لصحتك — الجسم يبدأ الشفاء خلال 20 دقيقة من آخر سيجارة')
  else if (form.habits.smoking === 'light')
    tips.push('لا توجد كمية آمنة من التدخين — حتى 5 سجائر يومياً ترفع خطر السكتة الدماغية بـ 40%')

  if (bmi >= 30)
    tips.push('خفض 5-10% من وزنك فقط يُحسّن ضغط الدم والسكر والكوليسترول بشكل ملحوظ')
  else if (bmi >= 25)
    tips.push('الوصول لـ BMI أقل من 25 يُخفّض خطر السكري النوع 2 بنسبة تصل لـ 58%')

  if (form.habits.waterIntake === 'low')
    tips.push('اشرب 2-2.5 لتر ماء يومياً — الجفاف الخفيف يقلل التركيز ويُجهد الكلى والقلب')

  return tips
}

// ── Positives ────────────────────────────────────────────────
export function buildPositives(form: HealthFormData, bmi: number): string[] {
  const pos: string[] = []

  if (form.habits.smoking === 'none')
    pos.push('لا تدخن — هذا القرار وحده يُقلّل خطر أمراض القلب والسرطان والسكتة الدماغية بشكل جذري')
  else if (form.habits.smoking === 'ex')
    pos.push('إقلاعك عن التدخين قرار ممتاز — الجسم يستمر في الشفاء لسنوات بعد الإقلاع')

  if (form.habits.exercise === 'frequent' || form.habits.exercise === 'daily')
    pos.push('نشاطك البدني ممتاز — أنت في أفضل 20% من حيث عامل الخطر الأكثر تأثيراً')
  else if (form.habits.exercise === 'moderate')
    pos.push('نشاطك البدني جيد — استمر وحاول الوصول لـ 4-5 مرات أسبوعياً')

  if (form.habits.sleep === 'good')
    pos.push('نومك الكافي يدعم مناعتك وصحة قلبك ويُوازن الهرمونات — عامل وقائي مهم')

  if (form.habits.diet === 'healthy')
    pos.push('نظامك الغذائي الصحي يُقلّل الالتهابات الجسمية ويحمي من الأمراض المزمنة المتعددة')

  if (form.habits.stress === 'low')
    pos.push('مستوى التوتر المنخفض يحمي قلبك وجهازك المناعي ويُطيل العمر المتوقع')

  if (bmi >= 18.5 && bmi < 25)
    pos.push(`وزنك مثالي (BMI ${bmi}) — الحفاظ عليه من أفضل ما يمكنك فعله لصحتك على المدى البعيد`)

  if (form.noFamilyHistory)
    pos.push('غياب التاريخ المرضي العائلي يُقلّل خطرك الوراثي بشكل ملحوظ')

  return pos
}

// ── Summary for Claude prompt ────────────────────────────────
export function buildFamilySummary(form: HealthFormData): string {
  if (form.noFamilyHistory) return 'لا يوجد تاريخ عائلي مرضي'
  if (form.familyMembers.length === 0) return 'غير محدد'

  const diseaseLabels: Record<string, string> = {
    diabetes: 'السكري', hypertension: 'ضغط الدم', heart_disease: 'أمراض القلب',
    stroke: 'السكتة الدماغية', colon_cancer: 'سرطان القولون',
    breast_cancer: 'سرطان الثدي', lung_cancer: 'سرطان الرئة',
    kidney_disease: 'أمراض الكلى', asthma: 'الربو',
    obesity: 'السمنة', autoimmune: 'أمراض المناعة',
    thyroid: 'الغدة الدرقية', mental_health: 'أمراض نفسية', other: 'أخرى',
  }
  const relLabels: Record<string, string> = {
    father: 'الأب', mother: 'الأم', brother: 'أخ', sister: 'أخت',
    son: 'ابن', daughter: 'بنت', grandfather_p: 'جد', grandmother_p: 'جدة',
    grandfather_m: 'جد', grandmother_m: 'جدة',
    uncle: 'عم/خال', aunt: 'عمة/خالة', cousin: 'ابن عم', other: 'أخرى',
  }

  return form.familyMembers
    .filter(m => m.relative && m.disease)
    .map(m => `${relLabels[m.relative] ?? m.relative}: ${diseaseLabels[m.disease] ?? m.disease}${m.age_at_diagnosis ? ` (${m.age_at_diagnosis} سنة)` : ''}`)
    .join('، ')
}



