                cursor: 'pointer',
              }}
              onClick={() => setSelectedReport(selectedReport?.id === lr.id ? null : lr)}
            >
              <div style={styles.reportCardHeader}>
                <div style={{ flex: 1 }}>
                  <div style={{ color: '#ccc', fontWeight: 500, fontSize: 14 }}>
