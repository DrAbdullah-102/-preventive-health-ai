                  )}
                  {lr.urgent_flag && (
                    <span style={{ ...styles.tag, background: '#2d0a0a', color: '#f87171' }}>🚨 عاجل</span>
                  )}
                  {lr.has_abnormal_values && !lr.urgent_flag && (
                    <span style={{ ...styles.tag, background: '#2d1a00', color: '#fbbf24' }}>⚠ غير طبيعي</span>
                  )}
                  {!lr.has_abnormal_values && lr.status === 'done' && (
                    <span style={{ ...styles.tag, background: '#052e16', color: '#34d399' }}>✓ طبيعي</span>
                  )}
                </div>
              </div>

              {lr.summary && (
                <div style={{ color: '#888', fontSize: 13, marginTop: 10, lineHeight: 1.6 }}>
                  {lr.summary}
                </div>
              )}

              {selectedReport?.id === lr.id && lr.ai_analysis && (
                <div style={styles.expandedAnalysis}>
                  <div style={{ color: '#818cf8', fontSize: 12, fontWeight: 600, marginBottom: 10 }}>
                    ✦ التحليل التفصيلي
                  </div>
                  <p style={{ color: '#bbb', fontSize: 13, lineHeight: 1.9, whiteSpace: 'pre-wrap' }}>
                    {lr.ai_analysis}
